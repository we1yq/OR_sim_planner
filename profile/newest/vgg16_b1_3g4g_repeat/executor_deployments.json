 {
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
   "labels": {
    "app.kubernetes.io/name": "migrant-model-runtime",
    "migrant.io/gpu": "rtx1-worker-gpu0",
    "migrant.io/model": "vgg16_image",
    "migrant.io/output-tokens": "0",
    "migrant.io/profile": "3g",
    "migrant.io/prompt-len": "0",
    "migrant.io/request-class": "x",
    "migrant.io/runtime-id": "catprof-vgg16-image-rtx1-worker-gpu0-3g",
    "migrant.io/runtime-model": "vgg16"
   },
   "name": "catprof-vgg16-image-rtx1-worker-gpu0-3g-runtime",
   "namespace": "or-sim"
  },
  "spec": {
   "replicas": 1,
   "selector": {
    "matchLabels": {
     "app.kubernetes.io/name": "migrant-model-runtime",
     "migrant.io/model": "vgg16_image",
     "migrant.io/output-tokens": "0",
     "migrant.io/prompt-len": "0",
     "migrant.io/request-class": "x",
     "migrant.io/runtime-id": "catprof-vgg16-image-rtx1-worker-gpu0-3g",
     "migrant.io/runtime-model": "vgg16"
    }
   },
   "strategy": {
    "type": "Recreate"
   },
   "template": {
    "metadata": {
     "annotations": {
      "migrant.io/binding-layer": "kubelet-device-plugin-allocate",
      "migrant.io/binding-mechanism": "per-mig-uuid-resource",
      "migrant.io/capacity": "0",
      "migrant.io/device-resource": "__DEVICE__",
      "migrant.io/expected-mig-uuid": "__UUID__",
      "migrant.io/long-term-identity": "logical-slot",
      "migrant.io/route-weight": "3",
      "migrant.io/slot-resource": "or-sim.io/rtx1-worker-gpu0-s0-4-3g"
     },
     "labels": {
      "app.kubernetes.io/name": "migrant-model-runtime",
      "migrant.io/gpu": "rtx1-worker-gpu0",
      "migrant.io/model": "vgg16_image",
      "migrant.io/output-tokens": "0",
      "migrant.io/profile": "3g",
      "migrant.io/prompt-len": "0",
      "migrant.io/request-class": "x",
      "migrant.io/runtime-id": "catprof-vgg16-image-rtx1-worker-gpu0-3g",
      "migrant.io/runtime-model": "vgg16"
     }
    },
    "spec": {
     "containers": [
      {
       "args": [
        "--addr=:18080"
       ],
       "env": [
        {
         "name": "MODEL_NAME",
         "value": "vgg16"
        },
        {
         "name": "OR_SIM_WORKLOAD",
         "value": "vgg16_image"
        },
        {
         "name": "OR_SIM_REQUEST_CLASS",
         "value": ""
        },
        {
         "name": "PROMPT_LEN",
         "value": "0"
        },
        {
         "name": "OUTPUT_TOKENS",
         "value": "0"
        },
        {
         "name": "RUNTIME_MODE",
         "value": "torchvision"
        },
        {
         "name": "TORCHVISION_WEIGHTS",
         "value": "default"
        },
        {
         "name": "TORCH_HOME",
         "value": "/opt/torch-cache"
        },
        {
         "name": "XDG_CACHE_HOME",
         "value": "/opt/cache"
        },
        {
         "name": "OR_SIM_RUNTIME_ID",
         "value": "catprof-vgg16-image-rtx1-worker-gpu0-3g"
        },
        {
         "name": "BATCH_SIZE",
         "value": "1"
        },
        {
         "name": "OR_SIM_GPU",
         "value": "rtx1-worker-gpu0"
        },
        {
         "name": "OR_SIM_PROFILE",
         "value": "3g"
        },
        {
         "name": "OR_SIM_SLOT_RESOURCE",
         "value": "or-sim.io/rtx1-worker-gpu0-s0-4-3g"
        },
        {
         "name": "OR_SIM_DEVICE_RESOURCE",
         "value": "__DEVICE__"
        },
        {
         "name": "OR_SIM_EXPECTED_MIG_UUID",
         "value": "__UUID__"
        },
        {
         "name": "OR_SIM_CPU_SET",
         "value": "2,34"
        },
        {
         "name": "OR_SIM_CPU_EXCLUDE",
         "value": "1,33"
        }
       ],
       "image": "localhost:10690/migrant-model-runtime:torchvision-worker-20260929",
       "imagePullPolicy": "IfNotPresent",
       "name": "runtime",
       "ports": [
        {
         "containerPort": 18080
        }
       ],
       "readinessProbe": {
        "failureThreshold": 3,
        "httpGet": {
         "path": "/healthz",
         "port": 18080
        },
        "periodSeconds": 1,
        "timeoutSeconds": 1
       },
       "resources": {
        "limits": {
         "__DEVICE__": 1
        },
        "requests": {
         "__DEVICE__": 1
        }
       }
      }
     ],
     "dnsPolicy": "ClusterFirstWithHostNet",
     "hostNetwork": true,
     "nodeSelector": {
      "kubernetes.io/hostname": "rtx1-worker"
     },
     "runtimeClassName": "nvidia",
     "terminationGracePeriodSeconds": 2,
     "tolerations": [
      {
       "operator": "Exists"
      }
     ]
    }
   }
  }
 },
