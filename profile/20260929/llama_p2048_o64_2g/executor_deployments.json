 {
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
   "labels": {
    "app.kubernetes.io/name": "migrant-model-runtime",
    "migrant.io/gpu": "rtx1-worker-gpu0",
    "migrant.io/model": "llama_p2048_o64",
    "migrant.io/output-tokens": "0",
    "migrant.io/profile": "2g",
    "migrant.io/prompt-len": "0",
    "migrant.io/request-class": "x",
    "migrant.io/runtime-id": "catprof-llama-p2048-o64-rtx1-worker-gpu0-2g",
    "migrant.io/runtime-model": "llama"
   },
   "name": "catprof-llama-p2048-o64-rtx1-worker-gpu0-2g-runtime",
   "namespace": "or-sim"
  },
  "spec": {
   "replicas": 1,
   "selector": {
    "matchLabels": {
     "app.kubernetes.io/name": "migrant-model-runtime",
     "migrant.io/model": "llama_p2048_o64",
     "migrant.io/output-tokens": "0",
     "migrant.io/prompt-len": "0",
     "migrant.io/request-class": "x",
     "migrant.io/runtime-id": "catprof-llama-p2048-o64-rtx1-worker-gpu0-2g",
     "migrant.io/runtime-model": "llama"
    }
   },
   "strategy": {
    "type": "Recreate"
   },
   "template": {
    "metadata": {
     "annotations": {
      "migrant.io/binding-layer": "kubelet-device-plugin-allocate",
      "migrant.io/binding-mechanism": "per-mig-uuid-resource",
      "migrant.io/capacity": "0",
      "migrant.io/device-resource": "__DEVICE__",
      "migrant.io/expected-mig-uuid": "__UUID__",
      "migrant.io/long-term-identity": "logical-slot",
      "migrant.io/route-weight": "2",
      "migrant.io/slot-resource": "or-sim.io/rtx1-worker-gpu0-s0-2-2g"
     },
     "labels": {
      "app.kubernetes.io/name": "migrant-model-runtime",
      "migrant.io/gpu": "rtx1-worker-gpu0",
      "migrant.io/model": "llama_p2048_o64",
      "migrant.io/output-tokens": "0",
      "migrant.io/profile": "2g",
      "migrant.io/prompt-len": "0",
      "migrant.io/request-class": "x",
      "migrant.io/runtime-id": "catprof-llama-p2048-o64-rtx1-worker-gpu0-2g",
      "migrant.io/runtime-model": "llama"
     }
    },
    "spec": {
     "containers": [
      {
       "args": [
        "--addr=:18080"
       ],
       "env": [
        {
         "name": "MODEL_NAME",
         "value": "llama"
        },
        {
         "name": "OR_SIM_WORKLOAD",
         "value": "llama_p2048_o64"
        },
        {
         "name": "OR_SIM_REQUEST_CLASS",
         "value": ""
        },
        {
         "name": "PROMPT_LEN",
         "value": "0"
        },
        {
         "name": "OUTPUT_TOKENS",
         "value": "0"
        },
        {
         "name": "RUNTIME_MODE",
         "value": "transformers"
        },
        {
         "name": "TORCHVISION_WEIGHTS",
         "value": "default"
        },
        {
         "name": "TORCH_HOME",
         "value": "/opt/torch-cache"
        },
        {
         "name": "XDG_CACHE_HOME",
         "value": "/opt/cache"
        },
        {
         "name": "OR_SIM_RUNTIME_ID",
         "value": "catprof-llama-p2048-o64-rtx1-worker-gpu0-2g"
        },
        {
         "name": "BATCH_SIZE",
         "value": "1"
        },
        {
         "name": "OR_SIM_GPU",
         "value": "rtx1-worker-gpu0"
        },
        {
         "name": "OR_SIM_PROFILE",
         "value": "2g"
        },
        {
         "name": "OR_SIM_SLOT_RESOURCE",
         "value": "or-sim.io/rtx1-worker-gpu0-s0-2-2g"
        },
        {
         "name": "OR_SIM_DEVICE_RESOURCE",
         "value": "__DEVICE__"
        },
        {
         "name": "OR_SIM_EXPECTED_MIG_UUID",
         "value": "__UUID__"
        },
        {
         "name": "OR_SIM_CPU_SET",
         "value": "2,34"
        },
        {
         "name": "OR_SIM_CPU_EXCLUDE",
         "value": "1,33"
        },
        {
         "name": "MODEL_ID",
         "value": "/opt/models/llama32-3b"
        },
        {
         "name": "HF_HOME",
         "value": "/opt/hf-cache"
        },
        {
         "name": "HUGGINGFACE_HUB_CACHE",
         "value": "/opt/hf-cache/hub"
        },
        {
         "name": "TRANSFORMERS_CACHE",
         "value": "/opt/hf-cache/hub"
        },
        {
         "name": "HF_TOKEN",
         "valueFrom": {
          "secretKeyRef": {
           "key": "HF_TOKEN",
           "name": "hf-token",
           "optional": true
          }
         }
        }
       ],
       "image": "localhost:10690/migrant-model-runtime:llama32-3b-cpuset-20260929",
       "imagePullPolicy": "IfNotPresent",
       "name": "runtime",
       "ports": [
        {
         "containerPort": 18080
        }
       ],
       "readinessProbe": {
        "failureThreshold": 3,
        "httpGet": {
         "path": "/healthz",
         "port": 18080
        },
        "periodSeconds": 1,
        "timeoutSeconds": 1
       },
       "resources": {
        "limits": {
         "__DEVICE__": 1
        },
        "requests": {
         "__DEVICE__": 1
        }
       },
       "volumeMounts": [
        {
         "mountPath": "/opt/hf-cache",
         "name": "hf-cache"
        }
       ]
      }
     ],
     "dnsPolicy": "ClusterFirstWithHostNet",
     "hostNetwork": true,
     "initContainers": [
      {
       "command": [
        "sh",
        "-c",
        "mkdir -p /cache/hub \u0026\u0026 chown -R 65532:65532 /cache"
       ],
       "image": "busybox:1.36",
       "name": "prepare-hf-cache",
       "volumeMounts": [
        {
         "mountPath": "/cache",
         "name": "hf-cache"
        }
       ]
      }
     ],
     "nodeSelector": {
      "kubernetes.io/hostname": "rtx1-worker"
     },
     "runtimeClassName": "nvidia",
     "terminationGracePeriodSeconds": 2,
     "tolerations": [
      {
       "operator": "Exists"
      }
     ],
     "volumes": [
      {
       "hostPath": {
        "path": "/var/lib/or-sim/hf-cache",
        "type": "DirectoryOrCreate"
       },
       "name": "hf-cache"
      }
     ]
    }
   }
  }
 },
